 "notes": [
  {
   "h": "Ordering",
   "lines": [
    "Мо́жно…? + accusative: Мо́жно ко́фе? Мо́жно во́ду? = Can I have…?",
    "Я хочу́… / Я бу́ду… (“I'll have…”) + accusative: Я бу́ду суп.",
    "Счёт, пожа́луйста! = The bill, please!"
   ]
  },
  {
   "h": "with and without",
   "lines": [
    "с + instrumental = with: чай с молоко́м, ры́ба с ри́сом, суп с мя́сом.",
    "без + genitive = without: ко́фе без молока́, чай без са́хара."
   ]
  },
  {
   "h": "есть / пить",
   "lines": [
    "есть (to eat) is irregular: ем, ешь, ест, еди́м, еди́те, едя́т. Don't mix it up with есть (there is).",
    "пить (to drink): пью, пьёшь, пьёт, пьём, пьёте, пьют."
   ]
  },
  {
   "h": "Useful for you",
   "lines": [
    "Э́то халя́льное? = Is this halal? Я не ем свини́ну = I don't eat pork.",
    "Без свини́ны, пожа́луйста = Without pork, please."
   ]
  }
 ],
