   "me": true
  }
 },
 "sentences": [
  {
   "sp": "a",
   "ru": "Извини́те, вы не зна́ете, где здесь апте́ка?",
   "en": "Excuse me, do you know where there's a pharmacy here?"
  },
  {
   "sp": "p",
   "ru": "Апте́ка? Да, зна́ю. Э́то недалеко́.",
   "en": "A pharmacy? Yes, I know. It's not far."
  },
  {
   "sp": "p",
   "ru": "Иди́те пря́мо, пото́м напра́во.",
   "en": "Go straight, then to the right."
  },
  {
   "sp": "a",
   "ru": "Пря́мо и напра́во. А пото́м?",
   "en": "Straight and to the right. And then?"
  },
  {
   "sp": "p",
   "ru": "Пото́м вы уви́дите банк. Апте́ка сле́ва от ба́нка.",
   "en": "Then you'll see a bank. The pharmacy is to the left of the bank."
  },
  {
   "sp": "a",
   "ru": "А э́то далеко́? Мо́жно дойти́ пешко́м?",
   "en": "And is it far? Can I walk there?"
  },
  {
   "sp": "p",
   "ru": "Да, коне́чно. Пять мину́т пешко́м.",
   "en": "Yes, of course. Five minutes on foot."
  },
  {
   "sp": "a",
   "ru": "Большо́е спаси́бо!",
   "en": "Thank you very much!"
  },
  {
   "sp": "p",
   "ru": "Не́ за что. Всего́ хоро́шего!",
   "en": "You're welcome. All the best!"
  }
 ],
