 "title": "Фотогра́фия",
 "en": "The family photo",
 "level": "A1",
 "after": 6,
 "pic": "Framed picture",
 "speakers": {
  "n": {
   "name": "А́нна",
   "en": "Anna",
   "pic": "Woman"
  },
  "a": {
   "name": "Али́",
   "en": "Ali",
   "pic": "Man",
   "me": true
  }
 },
 "sentences": [
  {
   "sp": "n",
   "ru": "Кто э́то на фотогра́фии?",
   "en": "Who is that in the photo?"
  },
  {
   "sp": "a",
   "ru": "Э́то моя́ семья́. Вот мой па́па и моя́ ма́ма.",
   "en": "This is my family. Here are my dad and my mum."
  },
  {
   "sp": "n",
   "ru": "А э́то кто?",
   "en": "And who is this?"
  },
  {
   "sp": "a",
   "ru": "Э́то мой брат. Его́ зову́т Ома́р. Ему́ два́дцать три го́да.",
   "en": "That's my brother. His name is Omar. He is twenty-three."
  },
  {
   "sp": "n",
   "ru": "А де́вочка?",
   "en": "And the girl?"
  },
  {
   "sp": "a",
   "ru": "Э́то моя́ сестра́ Ле́йла. Ей пять лет.",
   "en": "That's my sister Leila. She is five."
  },
  {
   "sp": "n",
   "ru": "Кака́я краси́вая! У тебя́ больша́я семья́.",
   "en": "How pretty! You have a big family."
  },
  {
   "sp": "a",
   "ru": "Да. А у тебя́ есть бра́тья и́ли сёстры?",
   "en": "Yes. And do you have brothers or sisters?"
  },
  {
   "sp": "n",
   "ru": "Нет, у меня́ нет ни бра́та, ни сестры́. Но у меня́ есть кот!",
   "en": "No, I have neither a brother nor a sister. But I have a cat!"
  },
  {
   "sp": "a",
   "ru": "Ха-ха, кот — то́же семья́!",
   "en": "Ha-ha, a cat is family too!"
  }
 ],
