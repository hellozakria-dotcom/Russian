  }
 },
 "sentences": [
  {
   "sp": "s",
   "ru": "Здра́вствуйте! Вам помо́чь?",
   "en": "Hello! Can I help you?"
  },
  {
   "sp": "a",
   "ru": "Да, пожа́луйста. Я ищу́ зи́мнюю ку́ртку.",
   "en": "Yes, please. I'm looking for a winter jacket."
  },
  {
   "sp": "s",
   "ru": "Како́й у вас разме́р?",
   "en": "What size are you?"
  },
  {
   "sp": "a",
   "ru": "Пятидеся́тый, наве́рное.",
   "en": "Fifty, probably."
  },
  {
   "sp": "s",
   "ru": "Вот, посмотри́те. Э́та зелёная о́чень тёплая.",
   "en": "Here, have a look. This green one is very warm."
  },
  {
   "sp": "a",
   "ru": "Краси́вая! Ско́лько она́ сто́ит?",
   "en": "Nice! How much does it cost?"
  },
  {
   "sp": "s",
   "ru": "Сто два́дцать е́вро, но сего́дня ски́дка два́дцать проце́нтов.",
   "en": "A hundred and twenty euros, but today there's twenty percent off."
  },
  {
   "sp": "a",
   "ru": "Зна́чит, девяно́сто шесть. Хорошо́, я её возьму́!",
   "en": "So ninety-six. OK, I'll take it!"
  },
  {
   "sp": "s",
   "ru": "Отли́чно! Ка́ртой и́ли нали́чными?",
   "en": "Great! By card or in cash?"
  },
  {
   "sp": "a",
   "ru": "Ка́ртой. И мо́жно чек, пожа́луйста?",
   "en": "By card. And can I have the receipt, please?"
  }
 ],
