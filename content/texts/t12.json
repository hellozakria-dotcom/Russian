 "sentences": [
  {
   "sp": "n",
   "ru": "Приве́т, Али́! Как прошли́ выходны́е?",
   "en": "Hi Ali! How was your weekend?"
  },
  {
   "sp": "a",
   "ru": "Хорошо́! В суббо́ту я рабо́тал, а в воскресе́нье мы игра́ли в волейбо́л.",
   "en": "Good! On Saturday I worked, and on Sunday we played volleyball."
  },
  {
   "sp": "n",
   "ru": "Здо́рово! Вы вы́играли?",
   "en": "Great! Did you win?"
  },
  {
   "sp": "a",
   "ru": "Нет, мы проигра́ли. Но бы́ло ве́село. А ты что де́лала?",
   "en": "No, we lost. But it was fun. And what did you do?"
  },
  {
   "sp": "n",
   "ru": "Я была́ у ба́бушки. Мы гото́вили и смотре́ли ста́рые фотогра́фии.",
   "en": "I was at my grandma's. We cooked and looked at old photos."
  },
  {
   "sp": "a",
   "ru": "Как ми́ло! А ты прочита́ла кни́гу, кото́рую я тебе́ дал?",
   "en": "How nice! And did you finish the book I gave you?"
  },
  {
   "sp": "n",
   "ru": "Ещё нет. Я чита́ла её вчера́ ве́чером, но усну́ла!",
   "en": "Not yet. I was reading it last night, but I fell asleep!"
  },
  {
   "sp": "a",
   "ru": "Ха-ха! Ничего́, ещё прочита́ешь.",
   "en": "Ha-ha! Never mind, you'll still finish it."
  }
 ],
