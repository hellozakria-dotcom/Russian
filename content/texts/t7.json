 "sentences": [
  {
   "sp": "n",
   "ru": "Али́, ты рабо́таешь и́ли у́чишься?",
   "en": "Ali, do you work or study?"
  },
  {
   "sp": "a",
   "ru": "Я учу́сь. А ещё я рабо́таю в кафе́ в суббо́ту.",
   "en": "I study. And I also work in a café on Saturdays."
  },
  {
   "sp": "n",
   "ru": "Здо́рово! А что ты лю́бишь де́лать?",
   "en": "Cool! And what do you like doing?"
  },
  {
   "sp": "a",
   "ru": "Я люблю́ игра́ть в волейбо́л и смотре́ть фи́льмы.",
   "en": "I like playing volleyball and watching films."
  },
  {
   "sp": "n",
   "ru": "Я то́же люблю́ волейбо́л! Но я пло́хо игра́ю.",
   "en": "I love volleyball too! But I play badly."
  },
  {
   "sp": "a",
   "ru": "Ничего́. Хо́чешь игра́ть с на́ми?",
   "en": "No problem. Do you want to play with us?"
  },
  {
   "sp": "n",
   "ru": "Да, коне́чно! А где вы игра́ете?",
   "en": "Yes, of course! And where do you play?"
  },
  {
   "sp": "a",
   "ru": "В па́рке, о́коло университе́та.",
   "en": "In the park, near the university."
  },
  {
   "sp": "n",
   "ru": "Я не зна́ю, где э́то. Ты мо́жешь сказа́ть а́дрес?",
   "en": "I don't know where that is. Can you tell me the address?"
  },
  {
   "sp": "a",
   "ru": "Коне́чно. Я напишу́ тебе́.",
   "en": "Of course. I'll text you."
  }
 ],
