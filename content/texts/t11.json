 "sentences": [
  {
   "sp": "a",
   "ru": "Извини́те, како́й авто́бус идёт в центр?",
   "en": "Excuse me, which bus goes to the centre?"
  },
  {
   "sp": "m",
   "ru": "Тре́тий и́ли пя́тый.",
   "en": "The number three or five."
  },
  {
   "sp": "a",
   "ru": "А трамва́й?",
   "en": "And the tram?"
  },
  {
   "sp": "m",
   "ru": "Трамва́й то́же идёт, но ме́дленно.",
   "en": "The tram goes there too, but slowly."
  },
  {
   "sp": "a",
   "ru": "Где мо́жно купи́ть биле́т?",
   "en": "Where can I buy a ticket?"
  },
  {
   "sp": "m",
   "ru": "В авто́бусе и́ли в приложе́нии.",
   "en": "On the bus or in the app."
  },
  {
   "sp": "a",
   "ru": "Спаси́бо! А вы то́же е́дете в центр?",
   "en": "Thanks! Are you going to the centre too?"
  },
  {
   "sp": "m",
   "ru": "Нет, я е́ду домо́й. Смотри́те, ваш авто́бус!",
   "en": "No, I'm going home. Look, your bus!"
  },
  {
   "sp": "a",
   "ru": "Ой, спаси́бо! Всего́ до́брого!",
   "en": "Oh, thanks! All the best!"
  }
 ],
