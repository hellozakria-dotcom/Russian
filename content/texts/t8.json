 "title": "Когда́ встре́тимся?",
 "en": "When shall we meet?",
 "level": "A1",
 "after": 8,
 "pic": "Spiral calendar",
 "speakers": {
  "n": {
   "name": "А́нна",
   "en": "Anna",
   "pic": "Woman"
  },
  "a": {
   "name": "Али́",
   "en": "Ali",
   "pic": "Man",
   "me": true
  }
 },
 "sentences": [
  {
   "sp": "a",
   "ru": "Приве́т! Что ты де́лаешь за́втра?",
   "en": "Hi! What are you doing tomorrow?"
  },
  {
   "sp": "n",
   "ru": "За́втра вто́рник… У́тром у меня́ уро́к, а днём я рабо́таю.",
   "en": "Tomorrow is Tuesday… In the morning I have a lesson, and in the afternoon I work."
  },
  {
   "sp": "a",
   "ru": "А ве́чером?",
   "en": "And in the evening?"
  },
  {
   "sp": "n",
   "ru": "Ве́чером я свобо́дна. Ты хо́чешь встре́титься?",
   "en": "In the evening I'm free. Do you want to meet?"
  },
  {
   "sp": "a",
   "ru": "Да. Дава́й в кафе́ в семь часо́в?",
   "en": "Yes. Let's meet at the café at seven?"
  },
  {
   "sp": "n",
   "ru": "В семь я не могу́. Мо́жет быть, в во́семь?",
   "en": "I can't at seven. Maybe at eight?"
  },
  {
   "sp": "a",
   "ru": "Хорошо́, в во́семь. А где?",
   "en": "OK, at eight. And where?"
  },
  {
   "sp": "n",
   "ru": "В кафе́ на у́лице Бри́вибас. Э́то бли́зко от метро́.",
   "en": "At the café on Brīvības Street. It's close to the metro."
  },
  {
   "sp": "a",
   "ru": "Отли́чно! Кото́рый час сейча́с?",
   "en": "Great! What time is it now?"
  },
  {
   "sp": "n",
   "ru": "Сейча́с пять мину́т пе́рвого. Мне пора́! До за́втра!",
   "en": "It's five past twelve. I have to go! See you tomorrow!"
  }
 ],
