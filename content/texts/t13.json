 "title": "Что наде́ть?",
 "en": "What should I wear?",
 "level": "A1",
 "after": 13,
 "pic": "Coat",
 "speakers": {
  "n": {
   "name": "А́нна",
   "en": "Anna",
   "pic": "Woman"
  },
  "a": {
   "name": "Али́",
   "en": "Ali",
   "pic": "Man",
   "me": true
  }
 },
 "sentences": [
  {
   "sp": "a",
   "ru": "А́нна, на у́лице о́чень хо́лодно?",
   "en": "Anna, is it very cold outside?"
  },
  {
   "sp": "n",
   "ru": "Да, ми́нус де́сять! Наде́нь тёплую ку́ртку.",
   "en": "Yes, minus ten! Put on a warm jacket."
  },
  {
   "sp": "a",
   "ru": "У меня́ то́лько си́няя ку́ртка. Она́ не о́чень тёплая.",
   "en": "I only have a blue jacket. It's not very warm."
  },
  {
   "sp": "n",
   "ru": "Тогда́ ну́жно купи́ть зи́мнюю. И ша́пку!",
   "en": "Then you need to buy a winter one. And a hat!"
  },
  {
   "sp": "a",
   "ru": "Я никогда́ не носи́л ша́пку. В Ли́вии жа́рко.",
   "en": "I've never worn a hat. It's hot in Libya."
  },
  {
   "sp": "n",
   "ru": "Здесь без ша́пки нельзя́! Хо́чешь, пойдём в магази́н вме́сте?",
   "en": "Here you can't go without a hat! Want to go to the shop together?"
  },
  {
   "sp": "a",
   "ru": "Да, коне́чно. Каки́е цвета́ сейча́с в мо́де?",
   "en": "Yes, of course. Which colours are in fashion now?"
  },
  {
   "sp": "n",
   "ru": "Чёрный всегда́ в мо́де. Но тебе́ пойдёт зелёный!",
   "en": "Black is always in fashion. But green will suit you!"
  }
 ],
