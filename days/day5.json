{"id": 5, "title": "Day 5", "topic": "Me, you, him: pronouns and “I have”", "words": [{"kind": "pron", "g": "x", "ru": "ты", "en": "you (one friend)", "pic": "index_pointing_at_the_viewer.png", "note": "Polite or plural: вы.", "id": "d5w1", "audio": "6421a53c53.mp3", "pr": "tih", "lemmas": ["ты"]}, {"kind": "pron", "g": "x", "ru": "он", "en": "he · it (masculine thing)", "pic": "man.png", "note": "он also means “it” for masculine things: Где дом? — Он там.", "id": "d5w2", "audio": "e7e72986e0.mp3", "pr": "on", "lemmas": ["он"]}, {"kind": "pron", "g": "x", "ru": "она́", "en": "she · it (feminine thing)", "pic": "woman.png", "note": "Где кни́га? — Она́ здесь. (It is here.)", "id": "d5w3", "audio": "05a1a8210f.mp3", "pr": "a-NA", "lemmas": ["она́"]}, {"kind": "pron", "g": "x", "ru": "оно́", "en": "it (neuter thing)", "pic": "window.png", "note": "For neuter nouns: окно́, письмо́ → оно́.", "id": "d5w4", "audio": "4d4aa364e9.mp3", "pr": "a-NO", "lemmas": ["оно́"]}, {"kind": "pron", "g": "x", "ru": "мы", "en": "we", "pic": "people_hugging.png", "id": "d5w5", "audio": "78ee86abec.mp3", "pr": "mih", "lemmas": ["мы"]}, {"kind": "pron", "g": "x", "ru": "вы", "en": "you (polite, or more than one)", "pic": "busts_in_silhouette.png", "id": "d5w6", "audio": "5ddf8ec8a4.mp3", "pr": "vih", "lemmas": ["вы"]}, {"kind": "pron", "g": "x", "ru": "они́", "en": "they", "pic": "houses.png", "id": "d5w7", "audio": "0f47b9d266.mp3", "pr": "a-NI", "lemmas": ["они́"]}, {"kind": "poss", "g": "adj", "ru": "мой / моя́ / моё / мои́", "lemmas": ["мой"], "en": "my", "pic": "person_raising_hand.png", "table": {"cols": ["", "form"], "rows": [["masc.", "мой брат"], ["fem.", "моя́ сестра́"], ["neut.", "моё окно́"], ["plural", "мои́ друзья́"]]}, "id": "d5w8", "audio": "578a09191a.mp3", "pr": "moi / ma-YA / ma-YO / ma-I"}, {"kind": "poss", "g": "adj", "ru": "твой / твоя́ / твоё / твои́", "lemmas": ["твой"], "en": "your (one friend)", "pic": "index_pointing_at_the_viewer.png", "id": "d5w9", "audio": "2678b335ee.mp3", "pr": "tvoi / tva-YA / tva-YO / tva-I"}, {"kind": "poss", "g": "adj", "ru": "наш / на́ша / на́ше / на́ши", "lemmas": ["наш"], "en": "our", "pic": "house.png", "id": "d5w10", "audio": "29b5a495a8.mp3", "pr": "nash / NA-sha / NA-she / NA-shi"}, {"kind": "poss", "g": "adj", "ru": "ваш / ва́ша / ва́ше / ва́ши", "lemmas": ["ваш"], "en": "your (polite / plural)", "pic": "briefcase.png", "id": "d5w11", "audio": "23f426e100.mp3", "pr": "vash / VA-sha / VA-she / VA-shi"}, {"kind": "poss", "g": "x", "ru": "его́ / её / их", "lemmas": ["его́", "её", "их"], "en": "his / her / their", "pic": "busts_in_silhouette.png", "note": "These never change: его́ брат, его́ сестра́, его́ друзья́. Said yi-VO, yi-YO, ikh.", "id": "d5w12", "audio": "660675c51d.mp3", "pr": "yi-VO / ye-YO / ikh"}, {"kind": "word", "g": "x", "ru": "есть", "en": "there is · (I) have", "pic": "check_mark_button.png", "note": "У меня́ есть… = I have… (literally: by me there is…).", "id": "d5w13", "audio": "12fe235616.mp3", "pr": "yest'", "lemmas": ["есть"]}, {"kind": "word", "g": "x", "ru": "нет", "en": "no · there is no", "pic": "cross_mark.png", "note": "У меня́ нет + genitive: нет маши́ны, нет бра́та.", "id": "d5w14", "audio": "53cb3ac6a1.mp3", "pr": "nyet", "lemmas": ["нет"]}], "sentences": [{"word": "d5w1", "ru": "Ты студе́нт?", "en": "Are you a student?", "pics": ["index_pointing_at_the_viewer.png", "graduation_cap.png"], "id": "d5s1", "audio": "0ce8a409b6.mp3", "pr": "tih stu-DYENT"}, {"word": "d5w1", "ru": "Ты говори́шь по-ру́сски?", "en": "Do you speak Russian?", "pics": ["index_pointing_at_the_viewer.png", "speech_balloon.png"], "id": "d5s2", "audio": "fa5c01d566.mp3", "pr": "tih ga-va-RISH' pa-RUS-ki"}, {"word": "d5w2", "ru": "Где мой телефо́н? — Он здесь.", "en": "Where is my phone? — It's here.", "pics": ["mobile_phone.png", "backhand_index_pointing_down.png"], "id": "d5s3", "audio": "ec117bb52c.mp3", "pr": "gdye moi ti-li-FON on zdyes'"}, {"word": "d5w2", "ru": "Он из Ли́вии.", "en": "He is from Libya.", "pics": ["man.png", "globe_showing_europe-africa.png"], "id": "d5s4", "audio": "c50d22ee99.mp3", "pr": "on is LI-vi-i"}, {"word": "d5w3", "ru": "Она́ студе́нтка.", "en": "She is a student.", "pics": ["woman.png", "graduation_cap.png"], "id": "d5s5", "audio": "79bfa265e9.mp3", "pr": "a-NA stu-DYENT-ka"}, {"word": "d5w3", "ru": "Где кни́га? — Она́ на столе́.", "en": "Where is the book? — It's on the table.", "pics": ["closed_book.png", "chair.png"], "id": "d5s6", "audio": "22f72cf50e.mp3", "pr": "gdye KNI-ga a-NA na sta-LYE"}, {"word": "d5w4", "ru": "Где письмо́? — Оно́ здесь.", "en": "Where is the letter? — It's here.", "pics": ["envelope.png", "backhand_index_pointing_down.png"], "id": "d5s7", "audio": "04be545e6a.mp3", "pr": "gdye pis'-MO a-NO zdyes'"}, {"word": "d5w5", "ru": "Мы живём в Ри́ге.", "en": "We live in Riga.", "pics": ["people_hugging.png", "cityscape.png"], "id": "d5s8", "audio": "e36e521431.mp3", "pr": "mih zhi-VYOM v RI-gye"}, {"word": "d5w5", "ru": "Мы друзья́.", "en": "We are friends.", "pics": ["people_hugging.png"], "id": "d5s9", "audio": "4b43d86b9c.mp3", "pr": "mih dru-ZYA"}, {"word": "d5w6", "ru": "Вы говори́те по-англи́йски?", "en": "Do you speak English? (polite)", "pics": ["busts_in_silhouette.png", "speech_balloon.png"], "id": "d5s10", "audio": "1034a2da53.mp3", "pr": "vih ga-va-RI-tye pa-ang-LIIS-ki"}, {"word": "d5w6", "ru": "Вы студе́нты?", "en": "Are you students? (plural)", "pics": ["busts_in_silhouette.png", "graduation_cap.png"], "id": "d5s11", "audio": "807727c546.mp3", "pr": "vih stu-DYEN-tih"}, {"word": "d5w7", "ru": "Они́ из Ла́твии.", "en": "They are from Latvia.", "pics": ["busts_in_silhouette.png", "globe_showing_europe-africa.png"], "id": "d5s12", "audio": "1c661c9fe6.mp3", "pr": "a-NI is LAT-vi-i"}, {"word": "d5w7", "ru": "Где они́? — Они́ до́ма.", "en": "Where are they? — They are at home.", "pics": ["red_question_mark.png", "house.png"], "id": "d5s13", "audio": "fb9e7cb650.mp3", "pr": "gdye a-NI a-NI DO-ma"}, {"word": "d5w8", "ru": "Э́то мой телефо́н.", "en": "This is my phone.", "pics": ["person_raising_hand.png", "mobile_phone.png"], "id": "d5s14", "audio": "cfa53351e5.mp3", "pr": "E-ta moi ti-li-FON"}, {"word": "d5w8", "ru": "Э́то мои́ друзья́.", "en": "These are my friends.", "pics": ["person_raising_hand.png", "people_hugging.png"], "id": "d5s15", "audio": "66284142e5.mp3", "pr": "E-ta ma-I dru-ZYA"}, {"word": "d5w9", "ru": "Э́то твоя́ маши́на?", "en": "Is this your car?", "pics": ["index_pointing_at_the_viewer.png", "automobile.png"], "id": "d5s16", "audio": "009ca7fee1.mp3", "pr": "E-ta tva-YA ma-SHI-na"}, {"word": "d5w10", "ru": "На́ша кварти́ра ма́ленькая.", "en": "Our flat is small.", "pics": ["house.png", "mouse.png"], "id": "d5s17", "audio": "4852c71680.mp3", "pr": "NA-sha kvar-TI-ra MA-lin'-ka-ya"}, {"word": "d5w11", "ru": "Э́то ва́ше ме́сто?", "en": "Is this your seat? (polite)", "pics": ["chair.png", "red_question_mark.png"], "id": "d5s18", "audio": "ab58b58f1e.mp3", "pr": "E-ta VA-she MYES-ta"}, {"word": "d5w12", "ru": "Э́то его́ кот.", "en": "This is his cat.", "pics": ["man.png", "cat.png"], "id": "d5s19", "audio": "b9f5b5a631.mp3", "pr": "E-ta yi-VO kot"}, {"word": "d5w12", "ru": "Э́то её сестра́.", "en": "This is her sister.", "pics": ["woman.png", "girl.png"], "id": "d5s20", "audio": "3f19fd7328.mp3", "pr": "E-ta ye-YO sist-RA"}, {"word": "d5w12", "ru": "Э́то их дом.", "en": "This is their house.", "pics": ["busts_in_silhouette.png", "house_with_garden.png"], "id": "d5s21", "audio": "43e047e2ef.mp3", "pr": "E-ta ikh dom"}, {"word": "d5w13", "ru": "У тебя́ есть телефо́н? — Да, есть.", "en": "Do you have a phone? — Yes, I do.", "pics": ["mobile_phone.png", "check_mark_button.png"], "id": "d5s22", "audio": "ac36a3dd5d.mp3", "pr": "u ti-BYA yest' ti-li-FON da yest'"}, {"word": "d5w14", "ru": "У тебя́ есть маши́на? — Нет.", "en": "Do you have a car? — No.", "pics": ["automobile.png", "cross_mark.png"], "id": "d5s23", "audio": "a4fd6d68d8.mp3", "pr": "u ti-BYA yest' ma-SHI-na nyet"}, {"mk": "У меня́ нет {маши́н|ы}.", "g": "f", "case": "нет + genitive", "en": "I don't have a car.", "pics": ["automobile.png", "cross_mark.png"], "id": "d5s24", "ru": "У меня́ нет маши́ны.", "audio": "8fb927372f.mp3", "pr": "u mi-NYA nyet ma-SHI-nih"}, {"mk": "У нас нет {хле́б|а}.", "g": "m", "case": "нет + genitive", "en": "We have no bread.", "pics": ["bread.png", "cross_mark.png"], "id": "d5s25", "ru": "У нас нет хле́ба.", "audio": "fcac591485.mp3", "pr": "u nas nyet KHLYE-ba"}, {"mk": "У {него́} есть сестра́.", "g": "m", "case": "у + him: него́", "en": "He has a sister.", "pics": ["man.png", "girl.png"], "id": "d5s26", "ru": "У него́ есть сестра́.", "audio": "061866f3c6.mp3", "pr": "u ni-GO yest' sist-RA"}, {"mk": "У {неё} есть кот.", "g": "f", "case": "у + her: неё", "en": "She has a cat.", "pics": ["woman.png", "cat.png"], "id": "d5s27", "ru": "У неё есть кот.", "audio": "7382e7231d.mp3", "pr": "u ni-YO yest' kot"}, {"mk": "У {них} есть дом.", "g": "pl", "case": "у + them: них", "en": "They have a house.", "pics": ["busts_in_silhouette.png", "house.png"], "id": "d5s28", "ru": "У них есть дом.", "audio": "63f4386fce.mp3", "pr": "u nikh yest' dom"}], "notes": [{"h": "The pronouns", "lines": ["я (I) · ты (you, friend) · он (he) · она́ (she) · оно́ (it) · мы (we) · вы (you, polite/plural) · они́ (they).", "он, она́, оно́ also mean “it”: they follow the gender of the thing. Где маши́на? — Она́ здесь."]}, {"h": "“I have”: у меня́ есть", "lines": ["Russian says “by me there is”: у меня́ есть брат = I have a brother.", "Change the pronoun: у меня́, у тебя́, у него́, у неё, у нас, у вас, у них.", "Question: У тебя́ есть маши́на? Answer: Да, есть. / Нет."]}, {"h": "“I don't have”: у меня́ нет + genitive", "lines": ["маши́на → У меня́ нет маши́ны. брат → У меня́ нет бра́та. хлеб → У нас нет хле́ба.", "Same genitive endings as Day 2: masculine -а, feminine -ы / -и."]}, {"h": "My, your, our change like adjectives", "lines": ["мой / моя́ / моё / мои́ follows the thing you own: мой брат, моя́ сестра́, моё окно́, мои́ друзья́.", "твой, наш, ваш work the same way.", "его́ (his), её (her), их (their) never change: его́ брат, его́ сестра́."]}, {"h": "The extra н", "lines": ["After a preposition, он / она́ / они́ get an н: у него́, у неё, у них (not у его́).", "Without a preposition there is no н: его́ зову́т Ива́н."]}], "tables": [{"title": "Pronouns", "cols": ["", "у … есть", "to … (dat.)", "… (acc.)"], "rows": [["я", "у меня́", "мне", "меня́"], ["ты", "у тебя́", "тебе́", "тебя́"], ["он", "у него́", "ему́", "его́"], ["она́", "у неё", "ей", "её"], ["мы", "у нас", "нам", "нас"], ["вы", "у вас", "вам", "вас"], ["они́", "у них", "им", "их"]]}, {"title": "My, your, our", "cols": ["", "masc.", "fem.", "neut.", "plural"], "rows": [["my", "мой", "моя́", "моё", "мои́"], ["your", "твой", "твоя́", "твоё", "твои́"], ["our", "наш", "на́ша", "на́ше", "на́ши"], ["your (pol.)", "ваш", "ва́ша", "ва́ше", "ва́ши"]]}], "video": "videos/day5.mp4"}