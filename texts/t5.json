{"id": 5, "kind": "conversation", "title": "В магази́не", "en": "At the shop", "level": "A1", "after": 5, "pic": "shopping_cart.png", "speakers": {"s": {"name": "Продаве́ц", "en": "shop assistant", "pic": "man.png"}, "a": {"name": "Али́", "en": "Ali", "pic": "man.png", "me": true}}, "sentences": [{"sp": "a", "ru": "Здра́вствуйте! У вас есть хлеб?", "en": "Hello! Do you have bread?", "audio": "7819b34aac.mp3"}, {"sp": "s", "ru": "Здра́вствуйте! Да, есть.", "en": "Hello! Yes, we do.", "audio": "3f915ba54f.mp3"}, {"sp": "a", "ru": "Да́йте, пожа́луйста, оди́н хлеб.", "en": "One loaf of bread, please.", "audio": "6ebd910081.mp3"}, {"sp": "s", "ru": "Что ещё?", "en": "Anything else?", "audio": "a152152ca4.mp3"}, {"sp": "a", "ru": "У вас есть молоко́?", "en": "Do you have milk?", "audio": "17a8bee20a.mp3"}, {"sp": "s", "ru": "Нет, молока́ сейча́с нет. Есть вода́ и сок.", "en": "No, there's no milk right now. There's water and juice.", "audio": "fd756aa139.mp3"}, {"sp": "a", "ru": "Хорошо́, тогда́ сок, пожа́луйста.", "en": "OK, then juice, please.", "audio": "6376c67b91.mp3"}, {"sp": "a", "ru": "Ско́лько всё сто́ит?", "en": "How much is everything?", "audio": "b9fa38c53a.mp3"}, {"sp": "s", "ru": "Хлеб — оди́н е́вро, сок — два е́вро. Всего́ три е́вро.", "en": "Bread is one euro, juice two euros. Three euros in total.", "audio": "301c32bc62.mp3"}, {"sp": "a", "ru": "Вот, пожа́луйста.", "en": "Here you are.", "audio": "8c8a6e6109.mp3"}, {"sp": "s", "ru": "Спаси́бо! До свида́ния!", "en": "Thank you! Goodbye!", "audio": "3806da9a3d.mp3"}], "gloss": {"здравствуйте": {"w": "здра́вствуйте", "lemma": "здра́вствуйте", "en": "hello", "info": "polite greeting", "pr": "ZDRAST-vui-tye", "audio": "dcb0f89a37.mp3", "k": "здравствуйте"}, "у": {"w": "у", "lemma": "у", "en": "at, by", "info": "У вас есть…? = Do you have…?", "pr": "u", "audio": "22842a6c50.mp3", "k": "у"}, "вас": {"w": "вас", "lemma": "вы", "en": "you", "info": "вы in the genitive (after у)", "pr": "vas", "audio": "7b466ae6bc.mp3", "k": "вы"}, "есть": {"w": "есть", "lemma": "есть", "en": "there is / (you) have", "info": "Да, есть = yes, there is / we have", "pr": "yest'", "audio": "43bacd672b.mp3", "k": "есть"}, "хлеб": {"w": "хлеб", "lemma": "хлеб", "en": "bread", "info": "noun, masculine", "pr": "khlyep", "audio": "0ce2f8cee2.mp3", "k": "хлеб"}, "да": {"w": "да", "lemma": "да", "en": "yes", "info": "", "pr": "da", "audio": "81c9dad102.mp3", "k": "да"}, "дайте": {"w": "да́йте", "lemma": "дать", "en": "give (please)", "info": "command form of дать (to give), polite: Да́йте, пожа́луйста… = Can I have…, please", "pr": "DAI-tye", "audio": "181b73048f.mp3", "k": "дать"}, "пожалуйста": {"w": "пожа́луйста", "lemma": "пожа́луйста", "en": "please · here you are", "info": "Day 4", "pr": "pa-ZHA-lus-ta", "audio": "527f8661b0.mp3", "k": "пожалуйста"}, "один": {"w": "оди́н", "lemma": "оди́н", "en": "one", "info": "number 1, masculine (хлеб)", "pr": "a-DIN", "audio": "9bf85686da.mp3", "k": "один"}, "что": {"w": "что", "lemma": "что", "en": "what", "info": "Что ещё? = what else?", "pr": "shto", "audio": "35ec10aa59.mp3", "k": "что"}, "еще": {"w": "ещё", "lemma": "ещё", "en": "else, more", "info": "adverb", "pr": "ye-SHCHO", "audio": "ac1812330c.mp3", "k": "еще"}, "молоко": {"w": "молоко́", "lemma": "молоко́", "en": "milk", "info": "noun, neuter", "pr": "ma-la-KO", "audio": "ba4383c13e.mp3", "k": "молоко"}, "нет": {"w": "нет", "lemma": "нет", "en": "no · there is no", "info": "нет + genitive: молока́ нет", "pr": "nyet", "audio": "df28b6f9df.mp3", "k": "нет"}, "молока": {"w": "молока́", "lemma": "молоко́", "en": "(no) milk", "info": "молоко́ in the genitive, after нет", "pr": "ma-la-KA", "audio": "10ac41b9ff.mp3", "k": "молоко"}, "сейчас": {"w": "сейча́с", "lemma": "сейча́с", "en": "now", "info": "adverb", "pr": "sii-CHAS", "audio": "270543cf0e.mp3", "k": "сейчас"}, "вода": {"w": "вода́", "lemma": "вода́", "en": "water", "info": "Day 1", "pr": "va-DA", "audio": "04ca29c6a0.mp3", "k": "вода"}, "и": {"w":