{"id": 11, "kind": "conversation", "title": "На остано́вке", "en": "At the bus stop", "level": "A1", "after": 11, "pic": "bus_stop.png", "speakers": {"m": {"name": "Мужчи́на", "en": "a man", "pic": "old_man.png"}, "a": {"name": "Али́", "en": "Ali", "pic": "man.png", "me": true}}, "sentences": [{"sp": "a", "ru": "Извини́те, како́й авто́бус идёт в центр?", "en": "Excuse me, which bus goes to the centre?", "audio": "03b1bbb5be.mp3"}, {"sp": "m", "ru": "Тре́тий и́ли пя́тый.", "en": "The number three or five.", "audio": "5532392f14.mp3"}, {"sp": "a", "ru": "А трамва́й?", "en": "And the tram?", "audio": "d8cc9a67ed.mp3"}, {"sp": "m", "ru": "Трамва́й то́же идёт, но ме́дленно.", "en": "The tram goes there too, but slowly.", "audio": "084920556f.mp3"}, {"sp": "a", "ru": "Где мо́жно купи́ть биле́т?", "en": "Where can I buy a ticket?", "audio": "924b43d80f.mp3"}, {"sp": "m", "ru": "В авто́бусе и́ли в приложе́нии.", "en": "On the bus or in the app.", "audio": "8bef00ade8.mp3"}, {"sp": "a", "ru": "Спаси́бо! А вы то́же е́дете в центр?", "en": "Thanks! Are you going to the centre too?", "audio": "7f32d8ec23.mp3"}, {"sp": "m", "ru": "Нет, я е́ду домо́й. Смотри́те, ваш авто́бус!", "en": "No, I'm going home. Look, your bus!", "audio": "f831dedb58.mp3"}, {"sp": "a", "ru": "Ой, спаси́бо! Всего́ до́брого!", "en": "Oh, thanks! All the best!", "audio": "e96cb3de5e.mp3"}], "gloss": {"какой": {"w": "како́й", "lemma": "како́й", "en": "which, what", "info": "", "pr": "ka-KOI", "audio": "a6db44f33d.mp3", "k": "какой"}, "автобус": {"w": "авто́бус", "lemma": "авто́бус", "en": "bus", "info": "", "pr": "av-TO-bus", "audio": "b9d3aabad1.mp3", "k": "автобус"}, "идет": {"w": "идёт", "lemma": "идти́", "en": "goes", "info": "идти́, он form: for buses and trams Russians also say идёт", "pr": "i-DYOT", "audio": "869b74243a.mp3", "k": "идти"}, "центр": {"w": "центр", "lemma": "центр", "en": "centre", "info": "в центр = to the centre (accusative)", "pr": "tsentr", "audio": "17a9048f4a.mp3", "k": "центр"}, 