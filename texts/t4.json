{"id": 4, "kind": "conversation", "title": "Знако́мство", "en": "Meeting someone new", "level": "A1", "after": 5, "pic": "handshake.png", "speakers": {"n": {"name": "А́нна", "en": "Anna", "pic": "woman.png"}, "a": {"name": "Али́", "en": "Ali", "pic": "man.png", "me": true}}, "sentences": [{"sp": "n", "ru": "Приве́т! Ты но́вый студе́нт?", "en": "Hi! Are you a new student?", "audio": "ad4c62e6b3.mp3"}, {"sp": "a", "ru": "Да. Меня́ зову́т Али́. А тебя́?", "en": "Yes. My name is Ali. And yours?", "audio": "5d148542aa.mp3"}, {"sp": "n", "ru": "Я А́нна. О́чень прия́тно!", "en": "I'm Anna. Nice to meet you!", "audio": "4fdc7bd0d2.mp3"}, {"sp": "a", "ru": "Мне то́же. Ты из Ри́ги?", "en": "Me too. Are you from Riga?", "audio": "fc30a53abc.mp3"}, {"sp": "n", "ru": "Да, я из Ри́ги. А ты отку́да?", "en": "Yes, I'm from Riga. And where are you from?", "audio": "1ef9a32aa4.mp3"}, {"sp": "a", "ru": "Я из Ли́вии.", "en": "I'm from Libya.", "audio": "28ae1cac54.mp3"}, {"sp": "n", "ru": "Здо́рово! Ты говори́шь по-ру́сски?", "en": "Cool! Do you speak Russian?", "audio": "aa37a1af9d.mp3"}, {"sp": "a", "ru": "Немно́го. Я ещё учу́ ру́сский.", "en": "A little. I'm still learning Russian.", "audio": "fc562a6241.mp3"}, {"sp": "n", "ru": "Ты хорошо́ говори́шь!", "en": "You speak well!", "audio": "28f4648b85.mp3"}, {"sp": "a", "ru": "Спаси́бо! Како́й у тебя́ но́мер телефо́на?", "en": "Thanks! What's your phone number?", "audio": "4c1370f5e6.mp3"}, {"sp": "n", "ru": "Два, три, пять, во́семь, ноль, оди́н, де́вять, де́вять.", "en": "Two, three, five, eight, zero, one, nine, nine.", "audio": "af846bb6be.mp3"}, {"sp": "a", "ru": "Спаси́бо! Пока́!", "en": "Thanks! Bye!", "audio": "98f37abf5a.mp3"}, {"sp": "n", "ru": "Пока́! До за́втра!", "en": "Bye! See you tomorrow!", "audio": "d26f25455c.mp3"}], "gloss": {"привет": {"w": "приве́т", "lemma": "приве́т", "en": "hi", "info": "greeting, to a friend", "pr": "pri-VYET", "audio": "c7e7fa5945.mp3", "k": "привет"}, "ты": {"w": "ты", "lemma": "ты", "en": "you (one friend)", "info": "pronoun (polite: вы)", "pr": "tih", "audio": "3973e79b1b.mp3", "k": "ты"}, "новый": {"w": "но́вый", "lemma": "но́вый", "en": "new", "info": "adjective, masculine (Day 2)", "pr": "NO-vih", "audio": "1be7e45cb5.mp3", "k": "новый"}, "студент": {"w": "студе́нт", "lemma": "студе́нт", "en": "student", "info": "noun, masculine (female: студе́нтка)", "pr": "stu-DYENT", "audio": "619809e3ca.mp3", "k": "студент"}, "да": {"w": "да", "lemma": "да", "en": "yes", "info": "opposite: нет", "pr": "da", "audio": "81c9dad102.mp3", "k": "да"}, "меня": {"w": "меня́", "lemma": "я", "en": "me", "info": "я in the accusative. Меня́ зову́т… = my name is…", "pr": "mi-NYA", "audio": "381aa6bcd9.mp3", "k": "я"}, "зовут": {"w": "зову́т", "lemma": "звать", "en": "(they) call", "info": "verb звать, они́ form", "pr": "za-VUT", "audio": "979ab0d4ce.mp3", "k": "звать"}, "али": {"w": "Али́", "lemma": "Али́", "en": "Ali (a name)", "info": "male name", "pr": "a-LI", "audio": "595548968a.mp3", "k": "али"}, "а": {"w": "а", "lemma": "а", "en": "and · but (contrast)", "info": "А тебя́? = And you? Used to switch to the other person or a new point", "pr": "a", "audio": "c15c49a8f5.mp3", "k": "а"}, "тебя": {"w": "тебя́", "lemma": "ты", "en": "you", "info": "ты in the accusative/genitive: тебя́ зову́т, у тебя́", "pr": "ti-BYA", "audio": "c438a15e79.mp3", "k": "ты"}, "я": {"w": "я", "lemma": "я", "en": "I", "info": "pronoun", "pr": "ya", "audio": "a633a29cfa.mp3", "k": "я"}, "анна": {"w": "А́нна", "lemma": "А́нна", "en": "Anna (a name)", "info": "female name", "pr": "A-na", "audio": "e82df0b5f8.mp3", "k": "анна"}, "очень": {"w": "о́чень", "lemma": "о́чень", "en": "very", "info": "adverb", "pr": "O-chin'", "audio": "997eeb2bfc.mp3", "k": "очень"}, "приятно": {"w": "прия́тно", "lemma": "прия́тно", "en": "pleasant, nice", "info": "О́чень прия́тно = Nice to meet you", "pr": "pri-YAT-na", "audio": "a1f1361b16.mp3", "k": "приятно"}, "мне": {"w": "мне", "lemma": "я", "en": "to me", "info": "я in the dative. Мне то́же = me too", "pr": "mnye", "audio": "950e27bf23.mp3", "k": "я"}, "тоже": {"w": "то́же", "lemma": "то́же", "en": "too, also", "info": "adverb", "pr": "TO-zhe", "audio": "bad74c9210.mp3", "k": "тоже"}, "из": {"w": "из", "lemma": "из", "en": "from", "info": "preposition + genitive", "pr": "is", "audio": "b98ccbc2df.mp3", "k": "из"}, "риги": {"w": "Ри́ги", "lemma": "Ри́га", "en": "Riga", "info": "Ри́га in the genitive: из Ри́ги", "pr": "RI-gi", "audio": "011a5e1cca.mp3", "k": "рига"}, "откуда": {"w": "отку́да", "lemma": "отку́да", "en": "where from", "info": "question word (Day 4)", "pr": "at-KU-da", "audio": "0f7da85fe2.mp3", "k": "откуда"}, "ливии": {"w": "Ли́вии", "lemma": "Ли́вия", "en": "Libya", "info": "Ли́вия in the genitive: из Ли́вии", "pr": "LI-vi-i", "audio": "4c98908ebb.mp3", "k": "ливия"}, "здорово": {"w": "здо́рово", "lemma": "здо́рово", "en": "great! cool!", "info": "informal exclamation", "pr": "ZDO-ra-va", "audio": "c057cd9228.mp3", "k": "здорово"}, "говоришь": {"w": "говори́шь", "lemma": "говори́ть", "en": "(you) speak", "info": "verb говори́ть, ты form: говорю́, говори́шь, говори́т…", "pr": "ga-va-RISH'", "audio": "7201e09d76.mp3", "k": "говорить"}, "по-русски": {"w": "по-ру́сски", "lemma": "по-ру́сски", "en": "in Russian", "info": "говори́ть по-ру́сски = to speak Russian", "pr": "pa-RUS-ki", "audio": "04fe2f91e2.mp3", "k": "по-русски"}, "немного": {"w": "немно́го", "lemma": "немно́го", "en": "a little", "info": "adverb (не + мно́го)", "pr": "nim-NO-va", "audio": "f8d0bd2ff1.mp3", "k": "немного"}, "еще": {"w": "ещё", "lemma": "ещё", "en": "still", "info": "adverb", "pr": "ye-SHCHYO", "audio": "ac1812330c.mp3", "k": "еще"}, "учу": {"w": "учу́", "lemma": "учи́ть", "en": "(I) learn", "info": "verb учи́ть, я form", "pr": "u-CHU", "audio": "2a5a7d132b.mp3", "k": "учить"}, "русский": {"w": "ру́сский", "lemma": "ру́сский", "en": "Russian (language)", "info": "учу́ ру́сский (язы́к) = I'm learning Russian", "pr": "RUS-kiy", "audio": "ecf088e8b6.mp3", "k": "русский"}, "хорошо": {"w": "хорошо́", "lemma": "хорошо́", "en": "well, good", "info": "adverb (opposite: пло́хо)", "pr": "kha-ra-SHO", "audio": "b647702fc9.mp3", "k": "хорошо"}, "спасибо": {"w": "спаси́бо", "lemma": "спаси́бо", "en": "thank you", "info": "Day 4", "pr": "spa-SI-ba", "audio": "c4193192e6.mp3", "k": "спасибо"}, "какой": {"w": "како́й", "lemma": "како́й", "en": "what, which", "info": "question word, changes like an adjective: како́й, кака́я, како́е, каки́е", "pr": "ka-KOI", "audio": "a6db44f33d.mp3", "k": "какой"}, "у": {"w": "у", "lemma": "у", "en": "at, by", "info": "Како́й у тебя́ но́мер? = what number do you have?", "pr": "u", "audio": "22842a6c50.mp3", "k": "у"}, "номер": {"w": "но́мер", "lemma": "но́мер", "en": "number", "info": "noun, masculine", "pr": "NO-mir", "audio": "950041c9c4.mp3", "k": "номер"}, "телефона": {"w": "телефо́на", "lemma": "телефо́н", "en": "(of) phone", "info": "телефо́н in the genitive: но́мер телефо́на = phone number", "pr": "ti-li-FO-na", "audio": "109b7f3fbe.mp3", "k": "телефон"}, "два": {"w": "два", "lemma": "два", "en": "two", "info": "number 2", "pr": "dva", "audio": "c2c854ecd4.mp3", "k": "два"}, "три": {"w": "три", "lemma": "три", "en": "three", "info": "number 3", "pr": "tri", "audio": "5789d86421.mp3", "k": "три"}, "пять": {"w": "пять", "lemma": "пять", "en": "five", "info": "number 5", "pr": "pyat'", "audio": "77db716dd3.mp3", "k": "пять"}, "восемь": {"w": "во́семь", "lemma": "во́семь", "en": "eight", "info": "number 8", "pr": "VO-sim'", "audio": "f0621c321a.mp3", "k": "восемь"}, "ноль": {"w": "ноль", "lemma": "ноль", "en": "zero", "info": "number 0", "pr": "nol'", "audio": "b020aadb67.mp3", "k": "ноль"}, "один": {"w": "оди́н", "lemma": "оди́н", "en": "one", "info": "number 1", "pr": "a-DIN", "audio": "9bf85686da.mp3", "k": "один"}, "девять": {"w": "де́вять", "lemma": "де́вять", "en": "nine", "info": "number 9", "pr": "DYE-vyat'", "audio": "718f015274.mp3", "k": "девять"}, "пока": {"w": "пока́", "lemma": "пока́", "en": "bye", "info": "to a friend", "pr": "pa-KA", "audio": "4cb30a5878.mp3", "k": "пока"}, "до": {"w": "до", "lemma": "до", "en": "until", "info": "До за́втра = see you tomorrow", "pr": "do", "audio": "538dc63d3c.mp3", "k": "до"}, "завтра": {"w": "за́втра", "lemma": "за́втра", "en": "tomorrow", "info": "adverb", "pr": "ZAVT-ra", "audio": "ed5f29342b.mp3", "k": "завтра"}}}