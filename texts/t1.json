{"id": 1, "title": "Приве́т! Меня́ зову́т Али́.", "en": "Hi! My name is Ali.", "level": "A1", "after": 4, "pic": "waving_hand.png", "sentences": [{"ru": "Приве́т! Меня́ зову́т Али́.", "en": "Hi! My name is Ali.", "audio": "e37185fb4d.mp3"}, {"ru": "Мне девятна́дцать лет.", "en": "I am nineteen (years old).", "audio": "a299d2d4d1.mp3"}, {"ru": "Я из Ли́вии, но сейча́с я живу́ в Ри́ге.", "en": "I'm from Libya, but now I live in Riga.", "audio": "fb3e388928.mp3"}, {"ru": "Я студе́нт. Я учу́сь в университе́те.", "en": "I'm a student. I study at university.", "audio": "a4a9ad82b9.mp3"}, {"ru": "Ри́га — краси́вый го́род.", "en": "Riga is a beautiful city.", "audio": "25c8ab8232.mp3"}, {"ru": "У меня́ есть брат и сестра́.", "en": "I have a brother and a sister.", "audio": "50b7b5933e.mp3"}, {"ru": "Мой брат живёт в Ли́вии.", "en": "My brother lives in Libya.", "audio": "36d4deed74.mp3"}, {"ru": "Ему́ два́дцать три го́да.", "en": "He is twenty-three.", "audio": "7171d5c614.mp3"}, {"ru": "Моя́ сестра́ ма́ленькая, ей пять лет.", "en": "My sister is little, she is five.", "audio": "7af48fea2c.mp3"}, {"ru": "Я чита́ю кни́ги и смотрю́ фи́льмы по-ру́сски.", "en": "I read books and watch films in Russian.", "audio": "9cac9dfb51.mp3"}, {"ru": "Я ещё пло́хо понима́ю, но я учу́ ру́сский язы́к ка́ждый день.", "en": "I still understand poorly, but I learn Russian every day.", "audio": "4d4d132507.mp3"}, {"ru": "Пока́!", "en": "Bye!", "audio": "2993227605.mp3"}], "gloss": {"привет": {"w": "приве́т", "lemma": "приве́т", "en": "hi", "info": "greeting, to a friend (polite: здра́вствуйте)", "pr": "pri-VYET", "audio": "c7e7fa5945.mp3"}, "меня": {"w": "меня́", "lemma": "я", "en": "me", "info": "pronoun я (I) in the accusative/genitive. Меня́ зову́т… = my name is…", "pr": "mi-NYA", "audio": "381aa6bcd9.mp3"}, "зовут": {"w": "зову́т", "lemma": "звать", "en": "(they) call", "info": "verb звать (to call), они́ form. Меня́ зову́т = they call me → my name is", "pr": "za-VUT", "audio": "979ab0d4ce.mp3"}, "али": {"w": "Али́", "lemma": "Али́", "en": "Ali (a name)", "info": "male name; foreign names in -и don't change", "pr": "a-LI", "audio": "595548968a.mp3"}, "мне": {"w": "мне", "lemma": "я", "en": "to me", "info": "pronoun я in the dative. Мне … лет = I am … years old", "pr": "mnye", "audio": "950e27bf23.mp3"}, "девятнадцать": {"w": "девятна́дцать", "lemma": "девятна́дцать", "en": "nineteen", "info": "number 19 (де́вять + на́дцать)", "pr": "di-vyat-NA-tsat'", "audio": "205f4097fc.mp3"}, "лет": {"w": "лет", "lemma": "год", "en": "years", "info": "genitive plural of год, used after 5–20: пять лет", "pr": "lyet", "audio": "257a7675c4.mp3"}, "я": {"w": "я", "lemma": "я", "en": "I", "info": "personal pronoun", "pr": "ya", "audio": "a633a29cfa.mp3"}, "из": {"w": "из", "lemma": "из", "en": "from (out of)", "info": "preposition + genitive: из Ли́вии", "pr": "is", "audio": "b98ccbc2df.mp3"}, "ливии": {"w": "Ли́вии", "lemma": "Ли́вия", "en": "Libya", "info": "Ли́вия in the genitive (из Ли́вии) or prepositional (в Ли́вии)", "pr": "LI-vi-i", "audio": "4c98908ebb.mp3"}, "но": {"w": "но", "lemma": "но", "en": "but", "info": "conjunction", "pr": "no", "audio": "cb5eae3770.mp3"}, "сейчас": {"w": "сейча́с", "lemma": "сейча́с", "en": "now", "info": "adverb", "pr": "sii-CHAS", "audio": "270543cf0e.mp3"}, "живу": {"w": "живу́", "lemma": "жить", "en": "(I) live", "info": "verb жить (to live), я form: живу́, живёшь, живёт, живём, живёте, живу́т", "pr": "zhi-VU", "audio": "de4e48f51c.mp3"}, "в": {"w": "в", "lemma": "в", "en": "in, at · to, into", "info": "preposition: + prepositional = where (в Ри́ге); + accusative = where to", "pr": "v", "audio": "bf44672226.mp3"}, "риге": {"w": "Ри́ге", "lemma": "Ри́га", "en": "(in) Riga", "info": "Ри́га in the prepositional: в Ри́ге = in Riga", "pr": "RI-gye", "audio": "1ae5ee29ed.mp3"}, "студент": {"w": "студе́нт", "lemma": "студе́нт", "en": "student (male)", "info": "noun, masculine (female: студе́нтка)", "pr": "stu-DYENT", "audio": "619809e3ca.mp3"}, "учусь": {"w": "учу́сь", "lemma": "учи́ться", "en": "(I) study", "info": "verb учи́ться (to study, be a student), я form: учу́сь, у́чишься, у́чится…", "pr": "u-CHUS'", "audio": "f85e4e0474.mp3"}, "университете": {"w": "университе́те", "lemma": "университе́т", "en": "(at) university", "info": "университе́т in the prepositional: в университе́те", "pr": "u-ni-vir-si-TYE-tye", "audio": "82e233be6a.mp3"}, "рига": {"w": "Ри́га", "lemma": "Ри́га", "en": "Riga", "info": "city name, feminine", "pr": "RI-ga", "audio": "06ba8692cc.mp3"}, "красивый": {"w": "краси́вый", "lemma": "краси́вый", "en": "beautiful", "info": "adjective, masculine nominative (f: краси́вая, n: краси́вое)", "pr": "kra-SI-vih", "audio": "06fa767228.mp3"}, "город": {"w": "го́род", "lemma": "го́род", "en": "city", "info": "noun, masculine (Day 1)", "pr": "GO-rat", "audio": "5b5a71d1da.mp3"}, "у": {"w": "у", "lemma": "у", "en": "at, by (someone)", "info": "preposition + genitive. У меня́ есть… = I have…", "pr": "u", "audio": "22842a6c50.mp3"}, "есть": {"w": "есть", "lemma": "есть", "en": "there is / (I) have", "info": "У меня́ есть брат = I have a brother (lit. by me there is a brother)", "pr": "yest'", "audio": "43bacd672b.mp3"}, "брат": {"w": "брат", "lemma": "брат", "en": "brother", "info": "noun, masculine (Day 2)", "pr": "brat", "audio": "9eb80271ac.mp3"}, "и": {"w": "и", "lemma": "и", "en": "and", "info": "conjunction", "pr": "i", "audio": "4bfb6432d7.mp3"}, "сестра": {"w": "сестра́", "lemma": "сестра́", "en": "sister", "info": "noun, feminine (Day 2)", "pr": "sist-RA", "audio": "f69a22fe4b.mp3"}, "мой": {"w": "мой", "lemma": "мой", "en": "my", "info": "possessive, masculine (f: моя́, n: моё, pl: мои́)", "pr": "moi", "audio": "ef33ee04ae.mp3"}, "живет": {"w": "живёт", "lemma": "жить", "en": "(he) lives", "info": "verb жить, он/она́ form", "pr": "zhi-VYOT", "audio": "7e48d922fb.mp3"}, "ему": {"w": "ему́", "lemma": "он", "en": "to him", "info": "pronoun он in the dative. Ему́ … го́да = he is … years old", "pr": "ye-MU", "audio": "5e2805eedb.mp3"}, "двадцать": {"w": "два́дцать", "lemma": "два́дцать", "en": "twenty", "info": "number 20", "pr": "DVA-tsat'", "audio": "50d7c787ef.mp3"}, "три": {"w": "три", "lemma": "три", "en": "three", "info": "number 3; after it: genitive singular (три го́да)", "pr": "tri", "audio": "5789d86421.mp3"}, "года": {"w": "го́да", "lemma": "год", "en": "years", "info": "genitive singular of год, used after 2–4 (and 23): три го́да", "pr": "GO-da", "audio": "94c8b4d575.mp3"}, "моя": {"w": "моя́", "lemma": "мой", "en": "my", "info": "possessive, feminine", "pr": "ma-YA", "audio": "8c432c89b7.mp3"}, "маленькая": {"w": "ма́ленькая", "lemma": "ма́ленький", "en": "little, small", "info": "adjective, feminine nominative", "pr": "MA-lin'-ka-ya", "audio": "537c5b622f.mp3"}, "ей": {"w": "ей", "lemma": "она́", "en": "to her", "info": "pronoun она́ in the dative. Ей пять лет = she is five", "pr": "yei", "audio": "e15d8a4624.mp3"}, "пять": {"w": "пять", "lemma": "пять", "en": "five", "info": "number 5; after it: genitive plural (пять лет)", "pr": "pyat'", "audio": "77db716dd3.mp3"}, "читаю": {"w": "чита́ю", "lemma": "чита́ть", "en": "(I) read", "info": "verb чита́ть, я form (Day 1)", "pr": "chi-TA-yu", "audio": "53a8432ee7.mp3"}, "книги": {"w": "кни́ги", "lemma": "кни́га", "en": "books", "info": "кни́га, accusative plural (= nominative plural for things)", "pr": "KNI-gi", "audio": "881e0f6b2a.mp3"}, "смотрю": {"w": "смотрю́", "lemma": "смотре́ть", "en": "(I) watch", "info": "verb смотре́ть, я form (Day 1)", "pr": "smat-RYU", "audio": "ee5b94130c.mp3"}, "фильмы": {"w": "фи́льмы", "lemma": "фильм", "en": "films", "info": "фильм, accusative plural", "pr": "FIL'-mih", "audio": "62e9f7eae9.mp3"}, "по-русски": {"w": "по-ру́сски", "lemma": "по-ру́сски", "en": "in Russian", "info": "adverb: говорю́ / пишу́ по-ру́сски", "pr": "pa-RUS-ki", "audio": "04fe2f91e2.mp3"}, "еще": {"w": "ещё", "lemma": "ещё", "en": "still · more", "info": "adverb", "pr": "ye-SHCHYO", "audio": "ac1812330c.mp3"}, "плохо": {"w": "пло́хо", "lemma": "пло́хо", "en": "badly, poorly", "info": "adverb (opposite: хорошо́)", "pr": "PLO-kha", "audio": "080b5f5af6.mp3"}, "понимаю": {"w": "понима́ю", "lemma": "понима́ть", "en": "(I) understand", "info": "verb понима́ть, я form (Day 1)", "pr": "pa-ni-MA-yu", "audio": "f1760e948c.mp3"}, "учу": {"w": "учу́", "lemma": "учи́ть", "en": "(I) learn", "info": "verb учи́ть (to learn something), я form: учу́ ру́сский = I'm learning Russian", "pr": "u-CHU", "audio": "2a5a7d132b.mp3"}, "русский": {"w": "ру́сский", "lemma": "ру́сский", "en": "Russian", "info": "adjective, masculine. ру́сский язы́к = the Russian language", "pr": "RUS-kiy", "audio": "ecf088e8b6.mp3"}, "язык": {"w": "язы́к", "lemma": "язы́к", "en": "language · tongue", "info": "noun, masculine", "pr": "ya-ZIHK", "audio": "540a7095e5.mp3"}, "каждый": {"w": "ка́ждый", "lemma": "ка́ждый", "en": "every, each", "info": "adjective, masculine. ка́ждый день = every day", "pr": "KAZH-dih", "audio": "03cf577ade.mp3"}, "день": {"w": "день", "lemma": "день", "en": "day", "info": "noun, masculine (ends in -ь)", "pr": "dyen'", "audio": "48e438a146.mp3"}, "пока": {"w": "пока́", "lemma": "пока́", "en": "bye", "info": "to a friend (polite: до свида́ния)", "pr": "pa-KA", "audio": "4cb30a5878.mp3"}}}