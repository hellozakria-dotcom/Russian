{"id": 3, "title": "Кот Ба́рсик", "en": "Barsik the cat", "level": "A1", "after": 4, "pic": "cat.png", "sentences": [{"ru": "У нас есть кот.", "en": "We have a cat.", "audio": "adbf4e5bd5.mp3"}, {"ru": "Его́ зову́т Ба́рсик.", "en": "His name is Barsik.", "audio": "bf0bccb305.mp3"}, {"ru": "Ба́рсик ма́ленький, но о́чень у́мный.", "en": "Barsik is small but very smart.", "audio": "9b7eff0886.mp3"}, {"ru": "Ему́ два го́да.", "en": "He is two years old.", "audio": "5c613b7055.mp3"}, {"ru": "Ка́ждое у́тро он смо́трит в окно́.", "en": "Every morning he looks out of the window.", "audio": "281c7f71b0.mp3"}, {"ru": "Он ви́дит большо́й го́род, маши́ны и люде́й.", "en": "He sees the big city, cars and people.", "audio": "e714559eda.mp3"}, {"ru": "Днём Ба́рсик спит на кни́гах.", "en": "In the daytime Barsik sleeps on the books.", "audio": "2fab7bb673.mp3"}, {"ru": "Моя́ сестра́ пи́шет ему́ пи́сьма.", "en": "My sister writes him letters.", "audio": "7c3badd311.mp3"}, {"ru": "Ба́рсик не уме́ет чита́ть, но он всё понима́ет.", "en": "Barsik can't read, but he understands everything.", "audio": "dfa4ab39ea.mp3"}], "gloss": {"у": {"w": "у", "lemma": "у", "en": "at, by (someone)", "info": "preposition + genitive. У нас есть… = we have…", "pr": "u", "audio": "22842a6c50.mp3"}, "нас": {"w": "нас", "lemma": "мы", "en": "us", "info": "pronoun мы in the genitive", "pr": "nas", "audio": "3050b35f9f.mp3"}, "есть": {"w": "есть", "lemma": "есть", "en": "there is / (we) have", "info": "У нас есть кот = we have a cat", "pr": "yest'", "audio": "43bacd672b.mp3"}, "кот": {"w": "кот", "lemma": "кот", "en": "cat (male)", "info": "noun, masculine (Day 2)", "pr": "kot", "audio": "04612456ba.mp3"}, "его": {"w": "его́", "lemma": "он", "en": "him", "info": "pronoun он in the accusative (said yi-VO). Его́ зову́т… = his name is…", "pr": "yi-VO", "audio": "e26797e1a8.mp3"}, "зовут": {"w": "зову́т", "lemma": "звать", "en": "(they) call", "info": "verb звать, они́ form", "pr": "za-VUT", "audio": "979ab0d4ce.m