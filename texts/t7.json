{"id": 7, "kind": "conversation", "title": "Что ты лю́бишь де́лать?", "en": "What do you like doing?", "level": "A1", "after": 7, "pic": "red_heart.png", "speakers": {"n": {"name": "А́нна", "en": "Anna", "pic": "woman.png"}, "a": {"name": "Али́", "en": "Ali", "pic": "man.png", "me": true}}, "sentences": [{"sp": "n", "ru": "Али́, ты рабо́таешь и́ли у́чишься?", "en": "Ali, do you work or study?", "audio": "127f67c059.mp3"}, {"sp": "a", "ru": "Я учу́сь. А ещё я рабо́таю в кафе́ в суббо́ту.", "en": "I study. And I also work in a café on Saturdays.", "audio": "d2b72a47df.mp3"}, {"sp": "n", "ru": "Здо́рово! А что ты лю́бишь де́лать?", "en": "Cool! And what do you like doing?", "audio": "c03b7ae5af.mp3"}, {"sp": "a", "ru": "Я люблю́ игра́ть в волейбо́л и смотре́ть фи́льмы.", "en": "I like playing volleyball and watching films.", "audio": "e157b9bd3f.mp3"}, {"sp": "n", "ru": "Я то́же люблю́ волейбо́л! Но я пло́хо игра́ю.", "en": "I love volleyball too! But I play badly.", "audio": "a300c26bcb.mp3"}, {"sp": "a", "ru": "Ничего́. Хо́чешь игра́ть с на́ми?", "en": "No problem. Do you want to play with us?", "audio": "189e0cca0a.mp3"}, {"sp": "n", "ru": "Да, коне́чно! А где вы игра́ете?", "en": "Yes, of course! And where do you play?", "audio": "ac23e9b0dd.mp3"}, {"sp": "a", "ru": "В па́рке, о́коло университе́та.", "en": "In the park, near the university.", "audio": "57389b11ec.mp3"}, {"sp": "n", "ru": "Я не зна́ю, где э́то. Ты мо́жешь сказа́ть а́дрес?", "en": "I don't know where that is. Can you tell me the address?", "audio": "3ab9a51bd7.mp3"}, {"sp": "a", "ru": "Коне́чно. Я напишу́ тебе́.", "en": "Of course. I'll text you.", "audio": "9ebfe8a5e9.mp3"}], "gloss": {"ты": {"w": "ты", "lemma": "ты", "en": "you", "info": "", "pr": "tih", "audio": "3973e79b1b.mp3", "k": "ты"}, "работаешь": {"w": "рабо́таешь", "lemma": "рабо́тать", "en": "(you) work", "info": "рабо́тать, ты form (Day 7)", "pr": "ra-BO-ta-yesh'", "audio": "5892fbd712.mp3", "k": "работать"}, "или": {"w": "и́ли", "lemma": "и́ли", "en": "or", "info": "", "pr": "I-li", "audio": "a8022b942f.mp3", "k": "или"}, "учишься": {"w": "у́чишься", "lemma": "учи́ться", "en": "(you) study", "info": "учи́ться, ты form (Day 7)", "pr": "U-chish'-sya", "audio": "8a2ca76e06.mp3", "k": "учиться"}, "еще": {"w": "ещё", "lemma": "ещё", "en": "also, as well", "info": "here: а ещё = and also", "pr": "ye-SHCHO", "audio": "ac1812330c.mp3", "k": "еще"}, "в": {"w": "в", "lemma": "в", "en": "in · on (a day)", "info": "в кафе́ = in a café; в суббо́ту = on Saturday", "pr": "v", "audio": "bf44672226.mp3", "k": "в"}, "кафе": {"w": "кафе́", "lemma": "кафе́", "en": "café", "info": "never changes", "pr": "ka-FYE", "audio": "60a9f56991.mp3", "k": "кафе"}, "субботу": {"w": "суббо́ту", "lemma": "суббо́та", "en": "(on) Saturday", "info": "в + accusative: в суббо́ту (Day 8)", "pr": "su-BO-tu", "audio": "cc8d983215.mp3", "k": "суббота"}, "что": {"w": "что", "lemma": "что", "en": "what", "info": "", "pr": "shto", "audio": "35ec10aa59.mp3", "k": "что"}, "любишь": {"w": "лю́бишь", "lemma": "люби́ть", "en": "(you) like, love", "info": "люби́ть, ты form (Day 7)", "pr": "LYU-bish'", "audio": "22149a07b2.mp3", "k": "любить"}, "делать": {"w": "де́лать", "lemma": "де́лать", "en": "to do", "info": "infinitive (Day 1)", "pr": "DYE-lat'", "audio": "384775fbf0.mp3", "k": "делать"}, "люблю": {"w": "люблю́", "lemma": "люби́ть", "en": "(I) like, love", "info": "люби́ть, я form: люблю́ (extra л)", "pr": "lyub-LYU", "audio": "147849fe75.mp3", "k": "любить"}, "играть": {"w": "игра́ть", "lemma": "игра́ть", "en": "to play", "info": "infinitive. игра́ть в + game: игра́ть в волейбо́л", "pr": "ig-RAT'", "audio": "70ecb2c0aa.mp3", "k": "играть"}, "волейбол": {"w": "волейбо́л", "lemma": "волейбо́л", "en": "volleyball", "info": "noun, masculine", "pr": "va-lei-BOL", "audio": "04e94f606c.mp3", "k": "волейбол"}, "смотреть": {"w": "смотре́ть", "lemma": "смотре́ть", "en": "to watch", "info": "infinitive (Day 1)", "pr": "smat-RYET'", "audio": "1c3386508a.