{"id": 2, "title": "В кафе́", "en": "At the café", "level": "A1", "after": 4, "pic": "hot_beverage.png", "sentences": [{"ru": "— Здра́вствуйте!", "en": "— Hello!", "audio": "c333023400.mp3"}, {"ru": "— Здра́вствуйте! Что вы хоти́те?", "en": "— Hello! What would you like?", "audio": "cc2cdeccb9.mp3"}, {"ru": "— Оди́н ко́фе и во́ду, пожа́луйста.", "en": "— One coffee and some water, please.", "audio": "b5f4605578.mp3"}, {"ru": "— Большо́й и́ли ма́ленький ко́фе?", "en": "— A big or a small coffee?", "audio": "c5c253d115.mp3"}, {"ru": "— Ма́ленький, пожа́луйста. Ско́лько э́то сто́ит?", "en": "— Small, please. How much is it?", "audio": "252538bb9b.mp3"}, {"ru": "— Ко́фе сто́ит три е́вро, вода́ — два е́вро.", "en": "— The coffee is three euros, the water two euros.", "audio": "0ab974f964.mp3"}, {"ru": "— Зна́чит, пять е́вро.", "en": "— So, five euros.", "audio": "d3a978c8b2.mp3"}, {"ru": "— Да. Вот, пожа́луйста.", "en": "— Yes. Here you are.", "audio": "599779ba37.mp3"}, {"ru": "— Спаси́бо! Хоро́шего дня!", "en": "— Thank you! Have a nice day!", "audio": "af1fcd9f2e.mp3"}, {"ru": "— Спаси́бо, вам то́же! До свида́ния!", "en": "— Thanks, you too! Goodbye!", "audio": "82c31eae33.mp3"}], "gloss": {"здравствуйте": {"w": "здра́вствуйте", "lemma": "здра́вствуйте", "en": "hello", "info": "polite greeting (the first в is silent)", "pr": "ZDRAST-vui-tye", "audio": "dcb0f89a37.mp3"}, "что": {"w": "что", "lemma": "что", "en": "what", "info": "question word, said “shto”", "pr": "shto", "audio": "35ec10aa59.mp3"}, "вы": {"w": "вы", "lemma": "вы", "en": "you (polite / plural)", "info": "pronoun", "pr": "vih", "audio": "095be3df8a.mp3"}, "хотите": {"w": "хоти́те", "lemma": "хоте́ть", "en": "(you) want", "info": "verb хоте́ть (to want), вы form: хочу́, хо́чешь, хо́чет, хоти́м, хоти́те, хотя́т", "pr": "kha-TI-tye", "audio": "3a953ab2ba.mp3"}, "один": {"w": "оди́н", "lemma": "оди́н", "en": "one", "info": "number 1, masculine (ко́фе is masculine)", "pr": "a-DIN", "audio": "9bf85686da.mp3"}, "кофе": {"w": "ко́фе", "lemma": "ко́фе", "en": "coffee", "info": "noun, masculine, never changes its ending", "pr": "KO-fye", "audio": "ddf6e3028b.mp3"}, "и": {"w": "и", "lemma": "и", "en": "and", "info": "conjunction", "pr": "i", "audio": "4bfb6432d7.mp3"}, "воду": {"w": "во́ду", "lemma": "вода́", "en": "water", "info": "вода́ in the accusative (the thing you order); stress moves: вода́ → во́ду", "pr": "VO-du", "audio": "d199a4a503.mp3"}, "пожалуйста": {"w": "пожа́луйста", "lemma": "пожа́луйста", "en": "please · here you are · you're welcome", "info": "said pa-ZHA-lus-ta", "pr": "pa-ZHA-lus-ta", "audio": "527f8661b0.mp3"}, "большой": {"w": "большо́й", "lemma": "большо́й", "en": "big", "info": "adjective, masculine (Day 2)", "pr": "bal'-SHOI", "audio": "3ff510586f.mp3"}, "или": {"w": "и́ли", "lemma": "и́ли", "en": "or", "info": "conjunction", "pr": "I-li", "audio": "a8022b942f.mp3"}, "маленький": {"w": "ма́ленький", "lemma": "ма́ленький", "en": "small", "info": "adjective, masculine (Day 2)", "pr": "MA-lin'-kiy", "audio": "685fe77a77.mp3"}, "сколько": {"w": "ско́лько", "lemma": "ско́лько", "en": "how much / how many", "info": "question word (Day 3)", "pr": "SKOL'-ka", "audio": "cd976c1636.mp3"}, "это": {"w": "э́то", "lemma": "э́то", "en": "this, it", "info": "pronoun; Э́то … = This is …", "pr": "E-ta", "audio": "3d4ae9f7ff.mp3"}, "стоит": {"w": "сто́ит", "lemma": "сто́ить", "en": "costs", "info": "verb сто́ить (to cost), он/она́ form", "pr": "STO-it", "audio": "45dc00998e.mp3"}, "три": {"w": "три", "lemma": "три", "en": "three", "info": "number 3", "pr": "tri", "audio": "5789d86421.mp3"}, "евро": {"w": "е́вро", "lemma": "е́вро", "en": "euro(s)", "info": "noun, never changes: оди́н е́вро, пять е́вро", "pr": "YEV-ra", "audio": "7b323b3be2.mp3"}, "вода": {"w": "вода́", "lemma": "вода́", "en": "water", "info": "noun, feminine, nominative (Day 1)", "pr": "va-DA", "audio": "04ca29c6a0.mp3"}, "два": {"w": "два", "lemma": "два", "en": "two", "info": "number 2 (feminine: две)", "pr": "dva", "audio": "c2c854ecd4.mp3"}, "значит": {"w": "зна́чит", "lemma": "зна́чит", "en": "so, that means", "info": "from зна́чить (to mean); very common in speech", "pr": "ZNA-chit", "audio": "3384ddbd68.mp3"}, "пять": {"w": "пять", "lemma": "пять", "en": "five", "info": "number 5", "pr": "pyat'", "audio": "77db716dd3.mp3"}, "да": {"w": "да", "lemma": "да", "en": "yes", "info": "opposite: нет (no)", "pr": "da", "audio": "81c9dad102.mp3"}, "вот": {"w": "вот", "lemma": "вот", "en": "here (is)", "info": "pointing word: Вот кни́га = Here is the book", "pr": "vot", "audio": "38186fa77a.mp3"}, "спасибо": {"w": "спаси́бо", "lemma": "спаси́бо", "en": "thank you", "info": "Спаси́бо большо́е = thank you very much", "pr": "spa-SI-ba", "audio": "c4193192e6.mp3"}, "хорошего": {"w": "хоро́шего", "lemma": "хоро́ший", "en": "good", "info": "хоро́ший in the genitive (said kha-RO-she-va). Хоро́шего дня = (I wish you) a good day", "pr": "kha-RO-she-va", "audio": "b69da982fe.mp3"}, "дня": {"w": "дня", "lemma": "день", "en": "day", "info": "день in the genitive", "pr": "dnya", "audio": "0871eeafdf.mp3"}, "вам": {"w": "вам", "lemma": "вы", "en": "to you", "info": "вы in the dative. Вам то́же = you too", "pr": "vam", "audio": "5cf8106187.mp3"}, "тоже": {"w": "то́же", "lemma": "то́же", "en": "too, also", "info": "adverb", "pr": "TO-zhe", "audio": "bad74c9210.mp3"}, "до": {"w": "до", "lemma": "до", "en": "until", "info": "preposition + genitive. До свида́ния = until we see again", "pr": "do", "audio": "538dc63d3c.mp3"}, "свидания": {"w": "свида́ния", "lemma": "свида́ние", "en": "meeting", "info": "свида́ние in the genitive; До свида́ния = goodbye", "pr": "svi-DA-ni-ya", "audio": "20d8d27f80.mp3"}}}