{"id": 2, "title": "В кафе́", "en": "At the café", "level": "A1", "after": 4, "pic": "hot_beverage.png", "sentences": [{"ru": "Здра́вствуйте!", "en": "Hello!", "sp": "a", "audio": "e6f6165a16.mp3"}, {"ru": "Здра́вствуйте! Что вы хоти́те?", "en": "Hello! What would you like?", "sp": "w", "audio": "d1e8d563ff.mp3"}, {"ru": "Оди́н ко́фе и во́ду, пожа́луйста.", "en": "One coffee and some water, please.", "sp": "a", "audio": "308b4cd9f2.mp3"}, {"ru": "Большо́й и́ли ма́ленький ко́фе?", "en": "A big or a small coffee?", "sp": "w", "audio": "25b799cdc2.mp3"}, {"ru": "Ма́ленький, пожа́луйста. Ско́лько э́то сто́ит?", "en": "Small, please. How much is it?", "sp": "a", "audio": "b3584f5770.mp3"}, {"ru": "Ко́фе сто́ит три е́вро, вода́ — два е́вро.", "en": "The coffee is three euros, the water two euros.", "sp": "w", "audio": "95a105421b.mp3"}, {"ru": "Зна́чит, пять е́вро.", "en": "So, five euros.", "sp": "w", "audio": "48c4d6b7f8.mp3"}, {"ru": "Да. Вот, пожа́луйста.", "en": "Yes. Here you are.", "sp": "a", "audio": "44e60725b8.mp3"}, {"ru": "Спаси́бо! Хоро́шего дня!", "en": "Thank you! Have a nice day!", "sp": "w", "audio": "1521f09037.mp3"}, {"ru": "Спаси́бо, вам то́же! До свида́ния!", "en": "Thanks, you too! Goodbye!", "sp": "a", "audio": "9d043146d6.mp3"}], "gloss": {"здравствуйте": {"w": "здра́вствуйте", "lemma": "здра́вствуйте", "en": "hello", "info": "polite greeting (the first в is silent)", "pr": "ZDRAST-vui-tye", "audio": "dcb0f89a37.mp3", "k": "здравствуйте"}, "что": {"w": "что", "lemma": "что", "en": "what", "info": "question word, said “shto”", "pr": "shto", "audio": "35ec10aa59.mp3", "k": "что"}, "вы": {"w": "вы", "lemma": "вы", "en": "you (polite / plural)", "info": "pronoun", "pr": "vih", "audio": "095be3df8a.mp3", "k": "вы"}, "хотите": {"w": "хоти́те", "lemma": "хоте́ть", "en": "(you) want", "info": "verb хоте́ть (to want), вы form: хочу́, хо́чешь, хо́чет, хоти́м, хоти́те, хотя́т", "pr": "kha-TI-tye", "audio": "3a953ab2ba.mp3", "k": "хотеть"}, "один": {"w": "оди́н", "lemma": "оди́н", "en": "one", "info": "number 1, masculine (ко́фе is masculine)", "pr": "a-DIN", "audio": "9bf85686da.mp3", "k": "один"}, "кофе": {"w": "ко́фе", "lemma": "ко́фе", "en": "coffee", "info": "noun, masculine, never changes its ending", "pr": "KO-fye", "audio": "ddf6e3028b.mp3", "k": "кофе"}, "и": {"w": "и", "lemma": "и", "en": "and", "info": "conjunction", "pr": "i", "audio": "4bfb6432d7.mp3", "k": "и"}, "воду": {"w": "во́ду", "lemma": "вода́", "en": "water", "info": "вода́ in the accusative (the thing you order); stress moves: вода́ → во́ду", "pr": "VO-du", "audio": "d199a4a503.mp3", "k": "вода"}, "пожалуйста": {"w": "пожа́луйста", "lemma": "пожа́луйста", "en": "please · here you are · you're welcome", "info": "said pa-ZHA-lus-ta", "pr": "pa-ZHA-lus-ta", "audio": "527f8661b0.mp3", "k": "пожалуйста"}, "большой": {"w": "большо́й", "lemma": "большо́й", "en": "big", "info": "adjective, masculine (Day 2)", "pr": "bal'-SHOI", "audio": "3ff510586f.mp3", "k": "большой"}, "или": {"w": "и́ли", "lemma": "и́ли", "en": "or", "info": "conjunction", "pr": "I-li", "audio": "a8022b942f.mp3", "k": "или"}, "маленький": {"w": "ма́ленький", "lemma": "ма́ленький", "en": "small", "info": "adjective, masculine (Day 2)", "pr": "MA-lin'-kiy", "audio": "685fe77a77.mp3", "k": "маленький"}, "сколько": {"w": "ско́лько", "lemma": "ско́лько", "en": "how much / how many", "info": "question word (Day 3)", "pr": "SKOL'-ka", "audio": "cd976c1636.mp3", "k": "сколько"}, "это": {"w": "э́то", "lemma": "э́то", "en": "this, it", "info": "pronoun; Э́то … = This is …", "pr": "E-ta", "audio": "3d4ae9f7ff.mp3", "k": "это"}, "стоит": {"w": "сто́ит", "lemma": "сто́ить", "en": "costs", "info": "verb сто́ить (to cost), он/она́ form", "pr": "STO-it", "audio": "45dc00998e.mp3", "k": "стоить"}, "три": {"w": "три", "lemma": "три", "en": "three", "info": "number 3", "pr": "tri", "audio": "5789d86421.mp3", "k": "три"}, "евро": {"w": "е́вро", "lemma": "е́вро", "en": "euro(s)", "info": "noun, never changes: оди́н е́вро, пять е́вро", "pr": "YEV-ra", "audio": "7b323b3be2.mp3", "k": "евро"}, "вода": {"w": "вода́", "lemma": "вода́", "en": "water", "info": "noun, feminine, nominative (Day 1)", "pr": "va-DA", "audio": "04ca29c6a0.mp3", "k": "вода"}, "два": {"w": "два", "lemma": "два", "en": "two", "info": "number 2 (feminine: две)", "pr": "dva", "audio": "c2c854ecd4.mp3", "k": "два"}, "значит": {"w": "зна́чит", "lemma": "зна́чит", "en": "so, that means", "info": "from зна́чить (to mean); very common in speech", "pr": "ZNA-chit", "audio": "3384ddbd68.mp3", "k": "значит"}, "пять": {"w": "пять", "lemma": "пять", "en": "five", "info": "number 5", "pr": "pyat'", "audio": "77db716dd3.mp3", "k": "пять"}, "да": {"w": "да", "lemma": "да", "en": "yes", "info": "opposite: нет (no)", "pr": "da", "audio": "81c9dad102.mp3", "k": "да"}, "вот": {"w": "вот", "lemma": "вот", "en": "here (is)", "info": "pointing word: Вот кни́га = Here is the book", "pr": "vot", "audio": "38186fa77a.mp3", "k": "вот"}, "спасибо": {"w": "спаси́бо", "lemma": "спаси́бо", "en": "thank you", "info": "Спаси́бо большо́е = thank you very much", "pr": "spa-SI-ba", "audio": "c4193192e6.mp3", "k": "спасибо"}, "хорошего": {"w": "хоро́шего", "lemma": "хоро́ший", "en": "good", "info": "хоро́ший in the genitive (said kha-RO-she-va). Хоро́шего дня = (I wish you) a good day", "pr": "kha-RO-she-va", "audio": "b69da982fe.mp3", "k": "хороший"}, "дня": {"w": "дня", "lemma": "день", "en": "day", "info": "день in the genitive", "pr": "dnya", "audio": "0871eeafdf.mp3", "k": "день"}, "вам": {"w": "вам", "lemma": "вы", "en": "to you", "info": "вы in the dative. Вам то́же = you too", "pr": "vam", "audio": "5cf8106187.mp3", "k": "вы"}, "тоже": {"w": "то́же", "lemma": "то́же", "en": "too, also", "info": "adverb", "pr": "TO-zhe", "audio": "bad74c9210.mp3", "k": "тоже"}, "до": {"w": "до", "lemma": "до", "en": "until", "info": "preposition + genitive. До свида́ния = until we see again", "pr": "do", "audio": "538dc63d3c.mp3", "k": "до"}, "с