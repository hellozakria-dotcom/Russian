{"id": 8, "kind": "conversation", "title": "Когда́ встре́тимся?", "en": "When shall we meet?", "level": "A1", "after": 8, "pic": "spiral_calendar.png", "speakers": {"n": {"name": "А́нна", "en": "Anna", "pic": "woman.png"}, "a": {"name": "Али́", "en": "Ali", "pic": "man.png", "me": true}}, "sentences": [{"sp": "a", "ru": "Приве́т! Что ты де́лаешь за́втра?", "en": "Hi! What are you doing tomorrow?", "audio": "588d406679.mp3"}, {"sp": "n", "ru": "За́втра вто́рник… У́тром у меня́ уро́к, а днём я рабо́таю.", "en": "Tomorrow is Tuesday… In the morning I have a lesson, and in the afternoon I work.", "audio": "dfe59f059e.mp3"}, {"sp": "a", "ru": "А ве́чером?", "en": "And in the evening?", "audio": "b3181f3753.mp3"}, {"sp": "n", "ru": "Ве́чером я свобо́дна. Ты хо́чешь встре́титься?", "en": "In the evening I'm free. Do you want to meet?", "audio": "29afeb5c1f.mp3"}, {"sp": "a", "ru": "Да. Дава́й в кафе́ в семь часо́в?", "en": "Yes. Let's meet at the café at seven?", "audio": "89a5afb1aa.mp3"}, {"sp": "n", "ru": "В семь я не могу́. Мо́жет быть, в во́семь?", "en": "I can't at seven. Maybe at eight?", "audio": "4f76fae379.mp3"}, {"sp": "a", "ru": "Хорошо́, в во́семь. А где?", "en": "OK, at eight. And where?", "audio": "890d78199b.mp3"}, {"sp": "n", "ru": "В кафе́ на у́лице Бри́вибас. Э́то бли́зко от метро́.", "en": "At the café on Brīvības Street. It's close to the metro.", "audio": "2fc3db815e.mp3"}, {"sp": "a", "ru": "Отли́чно! Кото́рый час сейча́с?", "en": "Great! What time is it now?", "audio": "400df60ddc.mp3"}, {"sp": "n", "ru": "Сейча́с пять мину́т пе́рвого. Мне пора́! До за́втра!", "en": "It's five past twelve. I have to go! See you tomorrow!", "audio": "6a101b14ae.mp3"}], "gloss": {"когда": {"w": "когда́", "lemma": "когда́", "en": "when", "info": "", "pr": "kag-DA", "audio": "a4b0192440.mp3", "k": "когда"}, "встретимся": {"w": "встре́тимся", "lemma": "встре́титься", "en": "(we) will meet", "info": "встре́титься (to meet), мы form = future/“shall we”", "pr": "VSTRYE-tim-sya", "audio": "ed55a613ed.mp3", "k": "встретиться"}, "встретиться": {"w": "встре́титься", "lemma": "встре́титься", "en": "to meet", "info": "perfective verb, infinitive", "pr": "VSTRYE-ti-tsya", "audio": "814db088de.mp3", "k": "встретиться"}, "завтра": {"w": "за́втра", "lemma": "за́втра", "en": "tomorrow", "info": "", "pr": "ZAVT-ra", "audio": "ed5f29342b.mp3", "k": "завтра"}, "вторник": {"w": "вто́рник", "lemma": "вто́рник", "en": "Tuesday", "info": "Day 8", "pr": "VTOR-nik", "audio": "fce98ba1a0.mp3", "k": "вторник"}, "утром": {"w": "у́тром", "lemma": "у́тром", "en": "in the morning", "info": "", "pr": "UT-ram", "audio": "ee43d12498.mp3", "k": "утром"}, "урок": {"w": "уро́к", "lemma": "уро́к", "en": "lesson", "info": "noun, masculine", "pr": "u-ROK", "audio": "e124cef3a2.mp3", "k": "урок"}, "днем": {"w": "днём", "lemma": "днём", "en": "in the afternoon", "info": "", "pr": "dnyom", "audio": "6f8e2bdcde.mp3", "k": "днем"}, "вечером": {"w": "ве́чером", "lemma": "ве́чером", "en": "in the evening", "info": "", "pr": "VYE-chi-ram", "audio": "e3afeb34e7.mp3", "k": "вечером"}, "свободна": {"w": "свобо́дна", "lemma": "свобо́дный", "en": "free", "info": "short form, feminine: я свобо́дна (a man says свобо́ден)", "pr": "sva-BOD-na", "audio": "291c1085b5.mp3", "k": "свободный"}, "давай": {"w": "дава́й", "lemma": "дава́й", "en": "let's", "info": "Дава́й + verb/plan = let's…", "pr": "da-VAI", "audio": "a14dd43b40.mp3", "k": "давай"}, "часов": {"w": "часо́в", "lemma": "час", "en": "o'clock", "info": "genitive plural after 5–20: в семь часо́в", "pr": "cha-SOF", "audio": "ab1e9e9ca8.mp3", "k": "час"}, "семь": {"w": "семь", "lemma": "семь", "en": "seven", "info": "", "pr": "syem'", "audio": "0c27fa9560.mp3", "k": "семь"}, "могу": {"w": "могу́", "lemma": "мочь", "en": "(I) can", "info": "мочь, я form", "pr": "ma-GU", "audio": "7b893675e1.mp3", "k": "мочь"}, "может": {"w": "мо́жет", "lemma": "мочь", "en": "may", "info": "Мо́жет быть = maybe", "pr": "MO-zhet", "audio": "f13c0582b9.mp3", "k": "мочь"}, "быть": {"w": "быть", "lemma": "быть", "en": "to be", "info": "Мо́жет быть = maybe", "pr": "biht'", "audio": "714cdce328.mp3", "k": "быть"}, "восемь": {"w": "во́семь", "lemma": "во́семь", "en": "eight", "info": "", "pr": "VO-sim'", "audio": "f0621c321a.mp3", "k": "восемь"}, "хорошо": {"w": "хорошо́", "lemma": "хорошо́", "en": "OK, good", "info": "", "pr": "kha-ra-SHO", "audio": "b647702fc9.mp3", "k": "хорошо"}, "улице": {"w": "у́лице", "lemma": "у́лица", "en": "street", "info": "на у́лице = on the street (prepositional)", "pr": "U-li-tse", "audio": "3d92fee59b.mp3", "k": "улица"}, "бривибас": {"w": "бри́вибас", "lemma": "Бри́вибас", "en": "Brīvības (street name)", "info": "Latvian name", "pr": "BRI-vi-bas", "audio": "60ad2df688.mp3", "k": "бривибас"}, "близко": {"w": "бли́зко", "lemma": "бли́зко", "en": "close, near", "info": "бли́зко от + genitive = close to", "pr": "BLIZ-ka", "audio": "f0cc70d3f2.mp3", "k": "близко"}, "от": {"w": "от", "lemma": "от", "en": "from", "info": "+ genitive", "pr": "ot", "audio": "7f164d1215.mp3", "k": "от"}, "метро": {"w": "метро́", "lemma": "метро́", "en": "metro", "info": "never changes", "pr": "mit-RO", "audio": "4eb6347667.mp3", "k": "метро"}, "отлично": {"w": "отли́чно", "lemma": "отли́чно", "en": "great, excellent", "info": "", "pr": "at-LICH-na", "audio": "a5c7eba89f.mp3", "k": "отлично"}, "который": {"w": "кото́рый", "lemma": "кото́рый", "en": "which", "info": "Кото́рый час? = What time is it?", "pr": "ka-TO-rih", "audio": "f874713c1e.mp3", "k": "который"}, "час": {"w": "час", "lemma": "час", "en": "hour, o'clock", "info": "", "pr": "chas", "audio": "62bbcd0501.mp3", "k": "час"}, "сейчас": {"w": "сейча́с", "lemma": "сейча́с", "en": "now", "info": "", "pr": "sii-CHAS", "audio": "270543cf0e.mp3", "k": "сейчас"}, "пять": {"w": "пять", "lemma": "пять", "en": "five", "info": "", "pr": "pyat'", "audio": "77db716dd3.mp3", "k": "пять"}, "минут": {"w": "мину́т", "lemma": "мину́та", "en": "minutes", "info": "genitive plural after 5", "pr": "mi-NUT", "audio": "dc0f703f25.mp3", "k": "минута"}, "первого": {"w": "пе́рвого", "lemma": "пе́рвый", "en": "of the first (hour)", "info": "пять мину́т пе́рвого = five minutes into the first hour = 12:05", "pr": "PYER-va-va", "audio": "74b77d161b.mp3", "k": "первый"}, "мне": {"w": "мне", "lemma": "я", "en": "to me", "info": "Мне пора́ = it's time for me (to go)", "pr": "mnye", "audio": "950e27bf23.mp3", "k": "я"}, "пора": {"w": "пора́", "lemma": "пора́", "en": "it's time", "info": "Мне пора́! = I have to go!", "pr": "pa-RA", "audio": "bb8f5ad177.mp3", "k": "пора"}, "делаешь": {"w": "де́лаешь", "lemma": "де́лать", "en": "(you) do", "info": "де́лать, ты form. Что ты де́лаешь? = What are you doing?", "pr": "DYE-la-yesh'", "audio": "22eb2f3578.mp3", "k": "делать"}, "привет": {"w": "приве́т", "lemma": "приве́т", "en": "hi", "info": "greeting, to a friend (polite: здра́вствуйте)", "pr": "pri-VYET", "audio": "c7e7fa5945.mp3", "k": "привет"}, "что": {"w": "что", "lemma": "что", "en": "what", "info": "", "pr": "shto", "audio": "35ec10aa59.mp3", "k": "что"}, "ты": {"w": "ты", "lemma": "ты", "en": "you", "info": "", "pr": "tih", "audio": "3973e79b1b.mp3", "k": "ты"}, "у": {"w": "у", "lemma": "у", "en": "at, by", "info": "У вас есть…? = Do you have…?", "pr": "u", "audio": "22842a6c50.mp3", "k": "у"}, "меня": {"w": "меня́", "lemma": "я", "en": "me", "info": "у меня́ = I have", "pr": "mi-NYA", "audio": "381aa6bcd9.mp3", "k": "я"}, "а": {"w": "а", "lemma": "а", "en": "and", "info": "", "pr": "a", "audio": "c15c49a8f5.mp3", "k": "а"}, "я": {"w": "я", "lemma": "я", "en": "I", "info": "", "pr": "ya", "audio": "a633a29cfa.mp3", "k": "я"}, "работаю": {"w": "рабо́таю", "lemma": "рабо́тать", "en": "(I) work", "info": "рабо́тать, я form", "pr": "ra-BO-ta-yu", "audio": "fd0048f96d.mp3", "k": "работать"}, "хочешь": {"w": "хо́чешь", "lemma": "хоте́ть", "en": "(you) want", "info": "хоте́ть, ты form (Day 7)", "pr": "KHO-chish'", "audio": "29abd430dd.mp3", "k": "хотеть"}, "д